# Copy to .env for local development. Never commit real values.
APP_ENV=development
DATABASE_URL=sqlite:///./dev.db

# Required for admin/moderation endpoints. Use a long random string.
ADMIN_API_KEY=
# Long random string used to hash reporter identities.
FINGERPRINT_SALT=

TRUST_PROXY=true
ALLOWED_ORIGINS=*
RETENTION_DAYS=180
RATE_LIMIT_REPORTS=10
RATE_LIMIT_ANALYZE=30

# Optional LLM second opinion (any OpenAI-compatible API, e.g. MiMo)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# WhatsApp Cloud API bot (see docs/WHATSAPP_SETUP.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
